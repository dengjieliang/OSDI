{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OSDI: Debug Lab2 (stable handshake)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bootloader.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "externalConsole": false,
      "preLaunchTask": "Start QEMU (GDB Mode)",
      "postDebugTask": "Stop QEMU",
      "stopAtConnect": true,
      "launchCompleteCommand": "None",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "text": "set architecture aarch64",
          "ignoreFailures": false
        },
        {
          "text": "break kernel_main",
          "ignoreFailures": true
        },
        {
          "text": "add-symbol-file ${workspaceFolder}/build/kernel8.elf 0x80000",
          "ignoreFailures": false
        }
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/kernel8.elf",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "text": "set architecture aarch64",
          "ignoreFailures": false
        }
      ]
    }
  ]
}