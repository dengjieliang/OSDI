{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Attach to QEMU (Bootloader)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bootloader.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "externalConsole": false,
      "stopAtEntry": true,
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/marginal/osdi-wsl-starter/osdi-lab0/CFile",
      "program": "/home/marginal/osdi-wsl-starter/osdi-lab0/CFile/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}