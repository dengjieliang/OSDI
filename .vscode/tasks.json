{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Kernel",
            "type": "shell",
            "command": "make",
            "args": ["all"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "problemMatcher": []
        },
        {
            "label": "Start QEMU (Background)",
            "type": "shell",
            // [關鍵修正]：啟動前先強制殺掉舊的 QEMU
            // "|| true" 的意思是：就算沒找到 QEMU 可以殺 (第一字執行時)，也不要報錯，繼續往下執行
            "command": "pkill -9 qemu-system-aarch64 || true && make qemu-gdb",
            "isBackground": true,
            "dependsOn": "Build Kernel",
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*qemu-system-aarch64", 
                    "endsPattern": "^.*$" 
                }
            }
        }
    ]
}