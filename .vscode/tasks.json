{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All",
            "type": "shell",
            "command": "make",
            "args": ["all"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Start QEMU (GDB Mode)",
            "type": "shell",
            "isBackground": true,
            // 強制殺掉舊的 QEMU，重新編譯，然後啟動新的
            "command": "pkill -9 qemu-system-aarch64 || true && make qemu-gdb",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            // 這個設定讓 VS Code 知道 QEMU 已經啟動完畢，可以開始連 GDB
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*qemu-system-aarch64", 
                    "endsPattern": "^.*$" 
                }
            },
            "dependsOn": "Build All"
        }
    ]
}