{
  "version": "2.0.0",
  "tasks": [
    {
      // Ctrl+Shift+B 會跑這個
      "label": "build & start qemu-gdb",
      "type": "shell",
      "command": "make",
      "args": ["qemu-gdb"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      // 純粹只 build 一次，不開 QEMU（有需要可以自己手動選）
      "label": "build (make)",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "run: qemu (in_asm)",
      "type": "shell",
      "command": "make",
      "args": ["qemu"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
